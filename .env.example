# ============================================
# EVENA FRONTEND - ENVIRONMENT VARIABLES
# ============================================

# Gateway Configuration
# ---------------------
# All services accessed through API Gateway
# The gateway handles routing to appropriate services:
#   /api/* -> Backend service
#   /sse/* -> SSE service
#   /     -> Frontend (self)

# Backend API URL (server-side - API routes, middleware)
# In Docker: Uses internal network (backend:8080)
# Local dev: Uses gateway or direct backend
API_URL=http://localhost/api

# Public API URL (client-side - browser requests)
# Uses relative path so it goes through gateway
NEXT_PUBLIC_API_URL=/api

# SSE Service URL (client-side - EventSource connections)
# Uses relative path so it goes through gateway
NEXT_PUBLIC_SSE_URL=/sse

# ============================================
# Alternative: Direct access (without gateway)
# ============================================
# API_URL=http://localhost:8080/api
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# NEXT_PUBLIC_SSE_URL=http://localhost:8000
